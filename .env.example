# =============================================================================
# FanSphere AI — environment configuration
# Copy to `.env` and populate. Do NOT commit the real .env file.
# =============================================================================

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fansphere_ai
POSTGRES_USER=fansphere
POSTGRES_PASSWORD=change_me

# --- Reddit (https://www.reddit.com/prefs/apps) --------------------------
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=fansphere-ai/0.1 by your_username

# --- Pipeline tuning -----------------------------------------------------
REDDIT_SUBREDDITS=Barca,soccer
REDDIT_POST_LIMIT=100
REDDIT_COMMENT_LIMIT=50
STATSBOMB_COMPETITION_IDS=11,2          # 11 = La Liga, 2 = UCL (example)
